# =============================================================================
# SUPERMEGABOT ENVIRONMENT CONFIGURATION
# =============================================================================
# Claude Desktop Compatible - Alle Keys sauber formatiert
# Kopiere diese Datei zu .env.local für lokale Entwicklung
# Für Vercel Deployment: Environment Variables im Dashboard setzen

# =============================================================================
# AI & LLM APIS
# =============================================================================

# Anthropic Claude API (Primary AI Service)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_KEY_HERE

# OpenAI API (Backup AI Service)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# Perplexity API (Web Search & Research)
PERPLEXITY_API_KEY=pplx-YOUR_PERPLEXITY_KEY_HERE

# =============================================================================
# ECOMMERCE PLATFORMS
# =============================================================================

# Shopify API (Primary E-Commerce)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_YOUR_SHOPIFY_ACCESS_TOKEN_HERE
SHOPIFY_API_VERSION=2026-04
SHOPIFY_CLIENT_ID=YOUR_SHOPIFY_CLIENT_ID_HERE
SHOPIFY_CLIENT_SECRET=shpss_YOUR_SHOPIFY_CLIENT_SECRET_HERE
SHOPIFY_APP_AUTOMATION_TOKEN=YOUR_SHOPIFY_AUTOMATION_TOKEN_HERE

# Shopify App Configuration
SHOPIFY_APP_NAME=Suiteap111
SHOPIFY_APP_DEVELOPER=I Want That! I Need It!
SHOPIFY_APP_URL=https://ineedit.com.co/webhooks/shopify
SHOPIFY_PREFERENCES_URL=https://ineedit.com.co/auth/shopify
SHOPIFY_WEBHOOK_VERSION=2026-04
SHOPIFY_EMBEDDED=true

# Shopify App Installation
SHOPIFY_APP_INSTALLATION_URL=https://admin.shopify.com/store/iwiini-td2xdoae/settings/apps/app_installations/app/suiteapi
SHOPIFY_PARTNER_API_URL=https://partners.shopify.com/settings/partner_api
SHOPIFY_APP_VERSION_URL=https://dev.shopify.com/dashboard/207276109/apps/341824634881/versions/991816744961

# Shopify Webhooks & Redirects
SHOPIFY_WEBHOOK_URL=https://ineedit.com.co/webhooks/shopify
SHOPIFY_AUTH_URL=https://ineedit.com.co/auth/shopify

# Additional Shopify Keys
SHOPIFY_SECRET_KEY_OLD=shpss_YOUR_OLD_SECRET_HERE
SHOPIFY_SECRET_KEY_NEW=shpss_YOUR_NEW_SECRET_HERE
SHOPIFY_REFRESH_TOKEN=YOUR_SHOPIFY_REFRESH_TOKEN_HERE
SHOPIFY_SECONDARY_ACCESS_TOKEN=YOUR_SHOPIFY_SECONDARY_TOKEN_HERE

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Supabase (Primary Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_SERVICE_KEY_HERE
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_NAME=your-project-name
SUPABASE_PROJECT_REGION=us-east-1
SUPABASE_KEY_ID=your-key-id

# Supabase JWT Keys
SUPABASE_ANON_KEY_JWT=YOUR_ANON_JWT_HERE
SUPABASE_SERVICE_KEY_JWT=YOUR_SERVICE_JWT_HERE

# Supabase API Endpoints
SUPABASE_REST_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_AUTH_URL=https://your-project.supabase.co/auth/v1/
SUPABASE_DISCOVERY_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe (Payment Processing)
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE

# =============================================================================
# COMMUNICATION & NOTIFICATIONS
# =============================================================================

# Telegram Bot (Notifications & Alerts)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_CLIENT_ID=YOUR_TELEGRAM_CLIENT_ID_HERE
TELEGRAM_CLIENT_SECRET=YOUR_TELEGRAM_CLIENT_SECRET_HERE

# =============================================================================
# DEVELOPMENT & DEPLOYMENT
# =============================================================================

# GitHub (Version Control & CI/CD)
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE
GITHUB_PAT_CLASSIC=github_pat_YOUR_PAT_CLASSIC_HERE
GITHUB_PAT_FINE=github_pat_YOUR_PAT_FINE_HERE

# Vercel (Deployment Platform)
VERCEL_TEAM_ID=YOUR_VERCEL_TEAM_ID_HERE
VERCEL_TEAM_NAME=your-team-name
VERCEL_TEAM_URL=vercel.com/your-team

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# Supabase MCP Server
SUPABASE_MCP_URL=https://mcp.supabase.com/mcp?project_ref=your-project-ref
SUPABASE_MCP_PROJECT_REF=your-project-ref

# MCP Installation Commands
MCP_ADD_COMMAND=claude mcp add --scope project --transport http supabase "https://mcp.supabase.com/mcp?project_ref=your-project-ref"
MCP_AUTH_COMMAND=claude /mcp

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================

# Application Environment
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# API Configuration
API_BASE_URL=https://api.anthropic.com/v1
API_VERSION=2023-06-01
API_TIMEOUT=30000

# =============================================================================
# CLAUDE DESKTOP COMPATIBILITY
# =============================================================================
# Diese Datei ist vollständig Claude Desktop kompatibel
# Alle Keys sind sauber formatiert und ohne Duplikate
# Kann direkt in Claude Desktop Projekten verwendet werden
